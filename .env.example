# API server (Render / any Node host). Never commit the real file.
PORT=4000
NODE_ENV=production

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Secret key (sb_secret_...). Server only. It is never sent to a browser.
SUPABASE_SECRET_KEY=

# Random string used to encrypt secret settings saved from the admin app: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# Comma separated emails that become admins when they sign in
ADMIN_EMAILS=you@example.com

# The two front-ends live on DIFFERENT origins on purpose
WEB_ORIGIN=https://lumen.example.com
ADMIN_ORIGIN=https://admin-xxxxxx.example.com
ADMIN_MAX_AUTH_AGE_HOURS=12
